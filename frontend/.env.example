# BREATHE Frontend - Environment Variables
# Copy to .env.local for local overrides. Never commit .env.local to git.

NEXT_PUBLIC_APP_NAME="BREATHE - Earth Information Jukebox"
NEXT_PUBLIC_APP_ENV="development"

# Set to "true" to use local mock fallback when backend is unreachable
NEXT_PUBLIC_ENABLE_MOCK_DATA="true"

# Backend API Endpoint (FastAPI)
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# NASA GIBS Direct Tile Endpoint (Fallback)
NEXT_PUBLIC_NASA_GIBS_ENDPOINT="https://gibs.earthdata.nasa.gov/wmts/epsg4326/best"

# Web Audio Configuration
NEXT_PUBLIC_AUDIO_DEFAULT_VOLUME="0.7"
